# Copy to .env (untracked) and set the real host paths.
# docker compose reads .env from this directory.

ODYSSEUS_SSH_KEY=/path/to/appdata/odysseus/data/ssh/id_ed25519.pub
MODELS_DIR=/path/to/models

# Optional: ROCm base for the llama.cpp build (docker compose --profile build build gfx906-base).
# Default is zenth815/mx-llama-rocm10-gfx906:latest (ROCm 10.1). To use your own
# TheRock-gfx906 build, build its SDK image and set e.g.:
# GFX906_BASE_IMAGE=rocm10-gfx906:10.2-sdk

# Optional build tuning (benchmark before/after; rebuild gfx906-base to apply):
# GFX906_AMDGPU_TARGETS=gfx906:xnack-       # MI50's exact ISA; default gfx906
# GFX906_HIP_FLAGS=-mllvm -amdgpu-sched-strategy=max-ilp   # default; set to a space for the compiler default
